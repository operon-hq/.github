# Code style configuration file for Operon HQ

root = true

# Global rules for all files
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Rule  Specific rules for C# files (.cs)
[*.cs]

#### Using Organization Rules ####
dotnet_sort_system_directives_first = true:suggestion
dotnet_separate_import_directive_groups = false:suggestion

#### C# Language Rules ####

# Require var only when the type is apparent (e.g., var x = new Customer())
csharp_style_var_elsewhere = false:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion

# Prefer explicit accessibility modifiers (e.g., private, internal)
dotnet_style_require_accessibility_modifiers = always:suggestion

# Modern pattern-based expressions (Pattern Matching)
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_not_pattern = true:suggestion

# Simplified object expressions (e.g., Customer c = new();)
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion

#### Spacing Rules ####

# Brace placement (Allman style - new line)
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# Spacing
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_declare_parameter_list_parentheses = false

#### Naming Conventions ####

# Interfaces should start with 'I'
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.severity = error
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.symbols = any_interface
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.style = prefix_with_i

dotnet_naming_symbols.any_interface.applicable_kinds = interface

dotnet_naming_style.prefix_with_i.required_prefix = I
dotnet_naming_style.prefix_with_i.capitalization = pascal_case

# Properties, Methods and Classes should be PascalCase
dotnet_naming_rule.pascal_case_for_members.severity = error
dotnet_naming_rule.pascal_case_for_members.symbols = public_members
dotnet_naming_rule.pascal_case_for_members.style = pascal_case_style

dotnet_naming_symbols.public_members.applicable_kinds = class, struct, method, property, enum
dotnet_naming_symbols.public_members.applicable_accessibilities = *

dotnet_naming_style.pascal_case_style.capitalization = pascal_case
